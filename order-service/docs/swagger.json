{
    "swagger": "2.0",
    "info": {
        "description": "Создание и чтение заказов, собственное хранилище, Kafka.",
        "title": "GoDelivery order-service",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/orders": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "Оформить заказ",
                "parameters": [
                    {
                        "description": "Товар и количество; demo_failure принимается только при SAGA_ENABLED и SAGA_DEMO_FAILURES",
                        "name": "order",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/contract.SagaCreateOrder"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Локальная оплата завершена",
                        "schema": {
                            "$ref": "#/definitions/contract.Order"
                        }
                    },
                    "202": {
                        "description": "Заказ принят; saga_id и saga_state присутствуют в режиме Saga",
                        "schema": {
                            "$ref": "#/definitions/contract.SagaOrder"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    },
                    "501": {
                        "description": "Not Implemented",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    }
                }
            }
        },
        "/api/v1/orders/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "Получить статус заказа",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID заказа",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "В режиме Strangler поля Saga отсутствуют",
                        "schema": {
                            "$ref": "#/definitions/contract.SagaOrder"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "contract.APIError": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "order": {
                    "$ref": "#/definitions/contract.Order"
                }
            }
        },
        "contract.Order": {
            "type": "object",
            "properties": {
                "amount_cents": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "owner": {
                    "type": "string"
                },
                "product_id": {
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "contract.SagaAPIError": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "order": {
                    "$ref": "#/definitions/contract.SagaOrder"
                }
            }
        },
        "contract.SagaCreateOrder": {
            "type": "object",
            "properties": {
                "demo_failure": {
                    "type": "string",
                    "enum": [
                        "payment",
                        "refund"
                    ]
                },
                "product_id": {
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer"
                }
            }
        },
        "contract.SagaOrder": {
            "type": "object",
            "properties": {
                "amount_cents": {
                    "type": "integer"
                },
                "failure_reason": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "owner": {
                    "type": "string"
                },
                "product_id": {
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer"
                },
                "saga_id": {
                    "type": "string"
                },
                "saga_state": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        }
    }
}