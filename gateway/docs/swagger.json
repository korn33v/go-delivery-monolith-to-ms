{
    "swagger": "2.0",
    "info": {
        "description": "Переключение HTTP-маршрутов между монолитом и сервисами.",
        "title": "GoDelivery Strangler Gateway",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/migration": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "migration"
                ],
                "summary": "Текущие флаги миграции (только чтение)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/config.Flags"
                        }
                    }
                }
            }
        },
        "/api/v1/orders": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "Создать заказ через переключаемый маршрут",
                "parameters": [
                    {
                        "description": "Товар и количество; demo_failure только в учебном режиме Saga",
                        "name": "order",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/contract.SagaCreateOrder"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/contract.Order"
                        }
                    },
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/contract.SagaOrder"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    },
                    "501": {
                        "description": "Not Implemented",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    }
                }
            }
        },
        "/api/v1/orders/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "Статус заказа; старые ID продолжают обслуживаться монолитом",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID заказа",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Поля Saga присутствуют при SAGA_ENABLED",
                        "schema": {
                            "$ref": "#/definitions/contract.SagaOrder"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    }
                }
            }
        },
        "/api/v1/stock/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "stock"
                ],
                "summary": "Остаток через переключаемый маршрут",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID товара",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/contract.Product"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/contract.APIError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "config.Flags": {
            "type": "object",
            "properties": {
                "async_payment": {
                    "type": "boolean"
                },
                "order_microservice": {
                    "type": "boolean"
                },
                "stock_bridge": {
                    "type": "boolean"
                },
                "stock_microservice": {
                    "type": "boolean"
                }
            }
        },
        "contract.APIError": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "order": {
                    "$ref": "#/definitions/contract.Order"
                }
            }
        },
        "contract.Order": {
            "type": "object",
            "properties": {
                "amount_cents": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "owner": {
                    "type": "string"
                },
                "product_id": {
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "contract.Product": {
            "type": "object",
            "properties": {
                "available": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "price_cents": {
                    "type": "integer"
                }
            }
        },
        "contract.SagaCreateOrder": {
            "type": "object",
            "properties": {
                "demo_failure": {
                    "type": "string",
                    "enum": [
                        "payment",
                        "refund"
                    ]
                },
                "product_id": {
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer"
                }
            }
        },
        "contract.SagaOrder": {
            "type": "object",
            "properties": {
                "amount_cents": {
                    "type": "integer"
                },
                "failure_reason": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "owner": {
                    "type": "string"
                },
                "product_id": {
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer"
                },
                "saga_id": {
                    "type": "string"
                },
                "saga_state": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        }
    }
}