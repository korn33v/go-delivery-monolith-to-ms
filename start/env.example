# These four flags are re-read for every request. Use: go run ./cmd/lab 1|2|3|4
ROUTE_STOCK_TO_MICROSERVICE=false
ROUTE_ORDER_TO_MICROSERVICE=false
ASYNC_PAYMENT_ACTIVE=false
MONOLITH_STOCK_BRIDGE_ACTIVE=false

GATEWAY_ADDR=:8080
MONOLITH_ADDR=:8081
STOCK_ADDR=:8082
ORDER_ADDR=:8083
PAYMENT_ADDR=:8084
# Host URLs for local services and lab commands. Compose overrides container URLs.
MONOLITH_URL=http://localhost:8081
STOCK_URL=http://localhost:8082
ORDER_URL=http://localhost:8083
FRONTEND_ORIGIN=http://localhost:5173
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_ENABLED=true
STOCK_BOOTSTRAP_FROM_MONOLITH=true
INITIAL_STOCK=50
PAYMENT_DELAY_MS=800
